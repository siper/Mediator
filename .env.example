# Mediator environment example. Copy to .env and adjust.

# Language for TMDB metadata requests (used when creating a TMDB source in UI)
MEDIATOR_TMDB_LANGUAGE=en-US

# Host port for the media UI (default: 42800)
MEDIATOR_HOST_PORT=42800

# Log level: DEBUG, INFO, WARN, ERROR
MEDIATOR_LOG_LEVEL=INFO

# Auth configuration
MEDIATOR_AUTH_ACCESS_TTL=15m
MEDIATOR_AUTH_REFRESH_TTL=168h

# Disable local password login (OIDC can still be used)
MEDIATOR_AUTH_DISABLE_LOGIN=false

# Disable open registration (create users via admin UI)
MEDIATOR_AUTH_DISABLE_REGISTRATION=false

# Optional OIDC provider
MEDIATOR_AUTH_OIDC_ISSUER=
MEDIATOR_AUTH_OIDC_CLIENT_ID=
MEDIATOR_AUTH_OIDC_CLIENT_SECRET=
MEDIATOR_AUTH_OIDC_ROLE_CLAIM=roles
MEDIATOR_AUTH_OIDC_ADMIN_ROLE=admin
